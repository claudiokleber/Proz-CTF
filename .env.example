# ============================================================================
# PROZ CTF — Variáveis de Ambiente (Exemplo Completo para Docker Compose / Debian)
# ============================================================================
# Copie este arquivo para `.env` antes de subir os containers:
#   cp .env.example .env
#
# IMPORTANTE: Nunca faça commit do arquivo `.env` nem de `FLAGS_REAIS.txt`.
# ============================================================================

# ----------------------------------------------------------------------------
# 1. Portas Expostas no Host (Notebook Debian / Rede Local da Sala de Aula)
# ----------------------------------------------------------------------------
# Porta da Plataforma CTF Segura (/ctf, placar, submissão de flags e painel do instrutor)
PLATFORM_PORT=3000

# Porta da Loja Vulnerável Alvo (/loja — isolada em container endurecido)
SHOP_PORT=3001

# ----------------------------------------------------------------------------
# 2. Credenciais do Banco PostgreSQL da Plataforma CTF (`platform-db`)
# ----------------------------------------------------------------------------
# DECISÃO: Este banco roda isolado na rede `platform-net` sem expor a porta 5432 ao host.
PLATFORM_DB_USER=proz_platform
PLATFORM_DB_PASSWORD=proz_platform_secret_2026
PLATFORM_DB_NAME=proz_ctf_platform

# URL de conexão Prisma usada pelo container `platform` (ou para comandos locais)
DATABASE_URL_PLATFORM="postgresql://proz_platform:proz_platform_secret_2026@platform-db:5432/proz_ctf_platform?schema=public"

# ----------------------------------------------------------------------------
# 3. Credenciais do Banco PostgreSQL da Loja Vulnerável (`shop-db`)
# ----------------------------------------------------------------------------
# DECISÃO: Banco exclusivo da Loja na rede `shop-net`, com credenciais distintas
# das usadas pela Plataforma CTF.
SHOP_DB_USER=proz_shop
SHOP_DB_PASSWORD=proz_shop_secret_2026
SHOP_DB_NAME=proz_ctf_shop

# URL de conexão Prisma usada pelo container `shop`
DATABASE_URL_SHOP="postgresql://proz_shop:proz_shop_secret_2026@shop-db:5432/proz_ctf_shop?schema=public"

# ----------------------------------------------------------------------------
# 4. Segredos Criptográficos e Credenciais Iniciais
# ----------------------------------------------------------------------------
# Segredo HMAC-SHA256 para assinar o cookie de sessão da Plataforma CTF (`HttpOnly`)
PLATFORM_SESSION_SECRET="proz-ctf-super-secret-platform-key-change-in-production-2026"

# Segredo mestre usado APENAS durante o seed inicial para que os containers `platform`
# e `shop` (que não compartilham rede nem disco) derivem as mesmas 17 flags dinâmicas.
# O `docker-entrypoint.sh` remove (`unset`) esta variável do container `shop` antes
# de iniciar o servidor HTTP.
CTF_FLAG_SECRET="proz-ctf-flag-derivation-master-secret-2026"

# Senha inicial da conta `instrutor@proz.com` na Plataforma CTF (/ctf).
# Se deixado em branco, o seed gera uma senha aleatória forte e a exibe nos logs
# (`docker compose logs platform`) e em `FLAGS_REAIS.txt`.
PLATFORM_ADMIN_INITIAL_PASSWORD=""

# Define a flag `Secure` do cookie de sessão da Plataforma.
# DECISÃO PARA SALA DE AULA (LAN HTTP): Manter `false` ao rodar via HTTP local
# (ex.: http://192.168.1.50:3000) para que os navegadores dos alunos aceitem o cookie.
COOKIE_SECURE="false"

# ----------------------------------------------------------------------------
# 5. Limites de Recursos do Container da Loja Vulnerável (`shop`)
# ----------------------------------------------------------------------------
# DECISÃO: Protege o notebook Debian contra exaustão de RAM/CPU caso algum aluno
# dispare muitas requisições simultâneas contra a loja.
SHOP_MEM_LIMIT=512m
SHOP_CPU_LIMIT=1.0

# ----------------------------------------------------------------------------
# 6. Configuração Opcional do Chatbot ProzBot (100% Offline por Padrão)
# ----------------------------------------------------------------------------
# DECISÃO OFFLINE: Deixe `AI_API_KEY` em branco para rodar sem internet!
# Quando vazio, o ProzBot utiliza automaticamente o motor determinístico local
# com as 3 camadas de Prompt Injection (Desafios 5, 11 e 16) funcionando 100% offline.
AI_API_KEY=""
AI_API_MODEL="gpt-4o-mini"
